<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

<div class="form-card">
 <form action="/new-category" method="POST">
    <div class="form-group">
      <label for="category_name">Category Name</label>
      <input
        type="text"
        id="category_name"
        name="category_name"
        maxlength="100"
        required
      />
    </div>

    <button type="submit">Create Category</button>
 </form>
</div>
</main>
<%- include('partials/footer') %>